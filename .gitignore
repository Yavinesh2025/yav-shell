# Build output (all projects build into artifacts/, see Directory.Build.props)
artifacts/
bin/
obj/
dist/

# IDE
.vs/
.idea/
*.user
*.suo
# Office keeps an owner file (~$name) beside a document while it is open
~$*

# Test and benchmark output
TestResults/
bench/results/*.local.json

# Local tooling state
.remember/
# Git worktrees that Claude Code makes for its agents. Only that folder: settings a project keeps in .claude/ stay committable.
.claude/worktrees/
